[Event "Grand Prix Attack: Closed Sicilian (2.e6)"]
[Date "2021.06.21"]
[Result "*"]
[Variant "Standard"]
[ECO "B23"]
[Opening "Sicilian Defense: Closed"]
[StudyName "Grand Prix Attack"]
[ChapterName "Closed Sicilian (2.e6)"]
[ChapterURL "https://lichess.org/study/xbNM05RB/dB7tgK63"]
[Annotator "https://lichess.org/@/siddharth_08"]
[UTCDate "2021.06.21"]
[UTCTime "18:00:37"]
[Orientation "white"]
[ChapterMode "gamebook"]

{ Begin the Grand Prix }
1. e4 c5 2. Nc3 e6 { Still play f4... } 3. f4 d5 { Here you must play Bb5, check! } 4. Bb5+ Nc6 { Capture the knight. } 5. Bxc6+ bxc6 { Support your e pawn } 6. d3 dxe4 7. dxe4 Qxd1+ { What should capture? } 8. Nxd1 { The knight! } 8... Nf6 { Support your pawn. } 9. Nc3 Be7 10. Nf3 Ba6 { Develop your bishop } 11. Bd2 O-O 12. O-O-O { Look at your pawn structure, 2 pawn islands. The opponent has three pawn islands, a doubled pair of pawns and an isolated a pawn. } { [%csl Ga2,Gb2,Gc2,Ge4,Gf4,Gg2,Gh2,Ra7,Rc6,Rc5,Re6,Rf7,Rg7,Rh7] } *

